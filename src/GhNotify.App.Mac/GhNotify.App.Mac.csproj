<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GhNotify.Core\GhNotify.Core.csproj" />
    <ProjectReference Include="..\GhNotify.UI\GhNotify.UI.csproj" />
    <ProjectReference Include="..\GhNotify.Platform.Mac\GhNotify.Platform.Mac.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <!-- Platform-neutral host code shared with the Windows host. -->
    <Compile Include="..\GhNotify.App\VelopackUpdateClient.cs" Link="Shared\VelopackUpdateClient.cs" />
    <Compile Include="..\GhNotify.App\AppVersion.cs" Link="Shared\AppVersion.cs" />
    <InternalsVisibleTo Include="GhNotify.Platform.Mac.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>osx-arm64;osx-x64</RuntimeIdentifiers>
    <AssemblyName>GhNotify</AssemblyName>
    <RootNamespace>GhNotify.App.Mac</RootNamespace>
    <StartupObject>GhNotify.App.Mac.Program</StartupObject>
    <Version>0.0.0-dev</Version>
  </PropertyGroup>

</Project>
