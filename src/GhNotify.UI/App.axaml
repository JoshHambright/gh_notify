<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GhNotify.UI.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Tokens (brushes per Light / Dark, fonts, geometry) and the keyed control themes, ported from Themes/Common.xaml. -->
        <ResourceInclude Source="avares://GhNotify.UI/Themes/Tokens.axaml" />
        <ResourceInclude Source="avares://GhNotify.UI/Themes/ControlThemes.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
