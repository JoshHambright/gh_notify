<UserControl x:Class="GhNotify.App.FiltersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GhNotify.App">
  <UserControl.Resources>
    <DataTemplate x:Key="PatternChip">
      <Border Style="{StaticResource Style.ChipBorder}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding}" VerticalAlignment="Center" />
          <Button Style="{StaticResource Style.IconButton}" Content="✕" FontSize="11" Width="22" Height="22" ToolTip="Remove"
                  Tag="{Binding}" Click="OnRemovePattern" Margin="4,0,0,0" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <ItemsPanelTemplate x:Key="Wrap"><WrapPanel /></ItemsPanelTemplate>
  </UserControl.Resources>
  <StackPanel>
    <ItemsControl x:Name="ErrorList" Foreground="{DynamicResource Brush.Red}" FontSize="12" Margin="0,0,0,8" />

    <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
      <Path Style="{StaticResource Style.EBars}" />
      <TextBlock Text="MUTED" Style="{StaticResource Style.SectionLabel}" FontSize="12" Margin="8,0,0,0" />
    </StackPanel>
    <TextBlock Text="Muted items stay in the list, dimmed, and never toast, sound or count." Foreground="{DynamicResource Brush.Muted}"
               FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap" />
    <ItemsControl x:Name="MuteChips" Tag="mute" ItemTemplate="{StaticResource PatternChip}" ItemsPanel="{StaticResource Wrap}" />
    <StackPanel Margin="0,0,0,22">
      <TextBox x:Name="MuteBox" HorizontalAlignment="Left" Width="260" Tag="gh:acme/legacy-* — Enter to add" KeyDown="OnPatternKey" TextChanged="OnPatternTyped" />
      <TextBlock x:Name="MuteHint" FontSize="12" Margin="2,4,0,0" Foreground="{DynamicResource Brush.Muted}" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
      <Path Style="{StaticResource Style.EBars}" />
      <TextBlock Text="HIDDEN" Style="{StaticResource Style.SectionLabel}" FontSize="12" Margin="8,0,0,0" />
    </StackPanel>
    <TextBlock Text="Hidden items are dropped from the popup entirely." Foreground="{DynamicResource Brush.Muted}"
               FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap" />
    <ItemsControl x:Name="HideChips" Tag="hide" ItemTemplate="{StaticResource PatternChip}" ItemsPanel="{StaticResource Wrap}" />
    <StackPanel Margin="0,0,0,12">
      <TextBox x:Name="HideBox" HorizontalAlignment="Left" Width="260" Tag="ado:contoso/sandbox — Enter to add" KeyDown="OnPatternKey" TextChanged="OnPatternTyped" />
      <TextBlock x:Name="HideHint" FontSize="12" Margin="2,4,0,0" Foreground="{DynamicResource Brush.Muted}" />
    </StackPanel>
    <TextBlock Foreground="{DynamicResource Brush.Muted}" FontSize="12" Margin="0,0,0,22" TextWrapping="Wrap"
               Text="Patterns: gh: or ado: limits to one provider · * matches within one path segment · contoso alone means the whole org." />

    <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
      <Path Style="{StaticResource Style.EBars}" />
      <TextBlock Text="TIMED MUTES" Style="{StaticResource Style.SectionLabel}" FontSize="12" Margin="8,0,0,0" />
    </StackPanel>
    <ItemsControl x:Name="TimedMutes">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type local:ActiveMute}">
          <DockPanel Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Unmute" Style="{StaticResource Style.PillGhost}" Tag="{Binding Pattern}" Click="OnUnmute" />
            <TextBlock VerticalAlignment="Center">
              <Run Text="{Binding Pattern, Mode=OneWay}" /><Run Text=" · " Foreground="{DynamicResource Brush.Muted}" /><Run
                   Text="{Binding Remaining, Mode=OneWay}" Foreground="{DynamicResource Brush.Muted}" />
            </TextBlock>
          </DockPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock x:Name="NoTimedMutes" Text="No timed mutes. Mute a row for a while from its ⋯ menu in the popup." Foreground="{DynamicResource Brush.Muted}"
               FontSize="12" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
