<Window x:Class="GhNotify.App.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="gh_notify" Width="420" Height="560"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="#1F1F1F" Foreground="#EDEDED" BorderBrush="#3A3A3A" BorderThickness="1"
        FontFamily="Segoe UI" FontSize="12" Deactivated="OnDeactivated">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Background" Value="#2D2D2D" />
      <Setter Property="Foreground" Value="#EDEDED" />
      <Setter Property="BorderBrush" Value="#4A4A4A" />
    </Style>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Padding="10,8" BorderBrush="#3A3A3A" BorderThickness="0,1,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Content="Refresh" Click="OnRefresh" />
          <Button Content="⋯" Click="OnMenu" />
        </StackPanel>
        <StackPanel>
          <TextBlock x:Name="LastRefreshed" Foreground="#9A9A9A" />
          <ItemsControl x:Name="Problems">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Foreground="#F0A040" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </DockPanel>
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock x:Name="EmptyText" Text="Nothing waiting on you." Margin="16" Foreground="#9A9A9A" />
        <ItemsControl x:Name="Sections">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,6">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="10,8,10,4" Foreground="#9A9A9A" />
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Padding="10,6" Background="Transparent" Cursor="Hand" Tag="{Binding Url}" MouseLeftButtonUp="OnRowClick">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Style.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2A2A" />
                              </Trigger>
                              <DataTrigger Binding="{Binding Stale}" Value="True">
                                <Setter Property="Opacity" Value="0.55" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel>
                            <TextBlock Foreground="#9A9A9A">
                              <Run Text="{Binding ProviderGlyph, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Repo, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Age, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}" Foreground="#9A9A9A" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding Detail, Converter={StaticResource NullToCollapsed}}" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding BadgeText}" ToolTip="{Binding BadgeTooltip}" Margin="6,0" VerticalAlignment="Center" />
                            <Button Content="{Binding RunButton}" Tag="{Binding Key}" Click="OnRunAgent"
                                    IsEnabled="{Binding CanRun}" ToolTip="{Binding RunDisabledReason}" ToolTipService.ShowOnDisabled="True"
                                    Visibility="{Binding RunButton, Converter={StaticResource NullToCollapsed}}" />
                            <Button Content="Open in Claude" Tag="{Binding Key}" Click="OnOpenInClaude"
                                    Visibility="{Binding CanOpenInClaude, Converter={StaticResource BoolToVis}}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
