<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GhNotify.Core\GhNotify.Core.csproj" />
    <ProjectReference Include="..\GhNotify.UI\GhNotify.UI.csproj" />
    <ProjectReference Include="..\GhNotify.Platform.Windows\GhNotify.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>GhNotify</AssemblyName>
    <RootNamespace>GhNotify.App</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StartupObject>GhNotify.App.Program</StartupObject>
    <Version>0.0.0-dev</Version>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

</Project>
