<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GhNotify.Core\GhNotify.Core.csproj" />
    <ProjectReference Include="..\GhNotify.GitHub\GhNotify.GitHub.csproj" />
    <ProjectReference Include="..\GhNotify.Ado\GhNotify.Ado.csproj" />
    <ProjectReference Include="..\GhNotify.Agents\GhNotify.Agents.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>GhNotify</AssemblyName>
    <RootNamespace>GhNotify.App</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>GhNotify.App.Program</StartupObject>
    <Version>0.0.0-dev</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
    <InternalsVisibleTo Include="GhNotify.App.Tests" />
  </ItemGroup>

</Project>
