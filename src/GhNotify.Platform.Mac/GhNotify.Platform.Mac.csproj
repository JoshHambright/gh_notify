<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GhNotify.Platform.Mac</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GhNotify.UI\GhNotify.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same wavs as Windows; extracted to the data folder and played with afplay. -->
    <EmbeddedResource Include="..\GhNotify.Platform.Windows\Sounds\*.wav" LogicalName="Sounds.%(Filename)%(Extension)" Link="Sounds\%(Filename)%(Extension)" />
    <!-- The Swift shim (native/mac/build.sh); only exists after a macOS build, so Windows builds without it. -->
    <None Include="..\..\native\mac\out\libGhNotifyMac.dylib" Condition="Exists('..\..\native\mac\out\libGhNotifyMac.dylib')"
          Link="libGhNotifyMac.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="GhNotify.Platform.Mac.Tests" />
  </ItemGroup>

</Project>
